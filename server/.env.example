# Copy to server/.env for local development. Never commit the real file.
NODE_ENV=development
PORT=8080

# Supabase: Project Settings > Database > Connection string (use the pooler URI) and set DATABASE_SSL=true.
# Local Postgres example below.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/verdant
DATABASE_SSL=false

# Random string, 32+ chars:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
# HMAC key shared with the chat system. The assessment's test secret:
WEBHOOK_SECRET=verdant-demo-secret-2026
BRAND_ID=verdant-co

# Comma-separated browser origins allowed to call the API (your frontend URL).
CORS_ORIGIN=http://localhost:5173

# LLM (any OpenAI-compatible chat completions API). OpenRouter example:
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
LLM_TIMEOUT_MS=25000

# Creates/updates this agent on startup (also: npm run seed). Choose your own password.
SEED_AGENT_EMAIL=agent@example.com
SEED_AGENT_PASSWORD=
SEED_AGENT_NAME=Support Agent
